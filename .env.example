# Copy this file to .env.local. Never commit .env.local.
# The values below are local loopback examples or empty placeholders.

# Local PostgreSQL connections. Replace the database name if needed.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/realm_local
REALM_RUNTIME_DATABASE_URL=postgresql://realm_runtime@127.0.0.1:5432/realm_local
REALM_TRANSFER_DATABASE_URL=postgresql://realm_transfer@127.0.0.1:5432/realm_local

# Keep the development server on loopback unless you explicitly control the LAN.
HOST_BIND=127.0.0.1
PORT=9999

# Optional local access/session values. Keep empty for a local-only session.
REALM_ACCESS_TOKEN=
REALM_SESSION_SECRET=

# Optional OpenAI-compatible model defaults. Configure secrets locally only.
REALM_MODEL_PROVIDER=lmstudio
REALM_MODEL_ID=
REALM_MODEL_BASE_URL=http://127.0.0.1:1234/v1
REALM_MODEL_API_KEY=

# Optional provider profiles. Leave empty unless you configure them locally.
REALM_OPENROUTER_BASE_URL=
REALM_OPENROUTER_MODEL=
REALM_OPENROUTER_API_KEY=
REALM_DEEPSEEK_API_KEY=
REALM_KIMI_API_KEY=
REALM_PROPAGATION_WORKSPACES=
