# Copy this file to .env.local. Never commit .env.local.
# The values below are loopback or placeholders only.

# One-shot migration/bootstrap connection (local PostgreSQL only).
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/realm_dev

# Long-running application connection (least-privileged role).
REALM_RUNTIME_DATABASE_URL=postgresql://realm_runtime@127.0.0.1:55432/realm_dev

# Optional transfer/CLI connection (least-privileged transfer role).
REALM_TRANSFER_DATABASE_URL=postgresql://realm_transfer@127.0.0.1:55432/realm_dev

# Local server binding. Keep loopback unless you explicitly control the network.
HOST_BIND=127.0.0.1
PORT=9999

# REALM_ACCESS_TOKEN retired: login is account name + optional password
# (accounts table). A leftover REALM_ACCESS_TOKEN is ignored and never used
# as a credential or startup prerequisite.
# Optional session-signing secret; when unset a stable per-install key is
# generated at <dataHome>/secure/session-secret (0600). Never commit it.
REALM_SESSION_SECRET=

# Optional model defaults. Leave blank to use the registered provider defaults,
# then configure a provider through the local settings page.
# LM Studio defaults to loopback http://127.0.0.1:1234/v1 (editable in settings).
REALM_MODEL_PROVIDER=lmstudio
REALM_MODEL_ID=
REALM_MODEL_BASE_URL=
REALM_MODEL_API_KEY=

# Optional OpenRouter profile defaults. Secrets stay local only.
REALM_OPENROUTER_BASE_URL=
REALM_OPENROUTER_MODEL=
REALM_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=

# Optional DeepSeek / Kimi Coding profile keys (never committed; configure in settings).
DEEPSEEK_API_KEY=
REALM_DEEPSEEK_API_KEY=
KIMI_API_KEY=
REALM_KIMI_API_KEY=

# Optional explicit workspace list for the propagation worker.
REALM_PROPAGATION_WORKSPACES=
