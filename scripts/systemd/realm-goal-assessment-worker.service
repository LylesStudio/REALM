# REALM durable Goal assessment worker —— systemd unit template.
#
# This is a repository template, not an installed unit. Installation/enabling is
# an operator action and is intentionally not performed by development tests:
#   cp scripts/systemd/realm-goal-assessment-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now realm-goal-assessment-worker.service
#
# Configure the database URL, installed RealmWorld root, trust-store path and
# optional workspace settings in the operator environment. The trust store
# contains public keys only; this template never stores credentials.
#
# The worker has its own PostgreSQL advisory lock and lease/fencing lifecycle.
# It does not start with realm-dev.service.

[Unit]
Description=REALM durable Goal assessment worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/works/REALM
# .env.local is operator-managed; no secret values belong in this template.
ExecStart=%h/.hermes/node/bin/node --env-file-if-exists=.env.local --experimental-strip-types scripts/goal-assessment-worker.mjs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
